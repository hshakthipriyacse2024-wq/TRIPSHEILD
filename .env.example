# TripShield AI - Environment Configuration
# Copy this file to .env and update values

# ============== Backend ==============
DATABASE_URL=sqlite:///./tripshield.db
SECRET_KEY=tripshield-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# AI Provider: mock | gemini | openai
AI_PROVIDER=mock

# Optional: LLM API Keys (not needed for demo)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# ============== Frontend ==============
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
